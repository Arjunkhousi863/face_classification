# =========================
# DATABASE (required)
# =========================
# Supabase: Project Settings → Database → Connection string (URI)
# Neon: Dashboard → Connection string
# Must support pgvector extension
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# =========================
# CLOUDINARY (required)
# =========================
# Dashboard: https://console.cloudinary.com → Settings → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# =========================
# JWT / AUTH (required)
# =========================
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# =========================
# FACE MATCH
# =========================
FACE_MATCH_THRESHOLD=0.45
# cosine distance via pgvector <=> ; lower distance = more similar
# similarity = 1 - distance  (tune after testing)

# =========================
# APP
# =========================
APP_NAME=Face Classification API
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Seed admin (created on first boot if not exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_NAME=System Admin
